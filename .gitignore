# Ignore files with no extention.
*
!*/
!*.*
!LICENSE
!Dockerfile

# Ignore hidden files, but not the license or github files.
.*
!.caos-expr
!DEPS
# The nim image's /worker trampoline — extensionless, and caos only ever
# sees git-tracked files, so an ignored worker is an invisible failure.
!caos/nim/worker
!.github/
!.github/**
!.gitignore
!.dockerignore

# Normal ignores.
nim.cfg
*.exe
nimcache
*.pdb
*.ilk
*.out
out/
tmp/
build/
# ...but NOT the `build` tool. A tool is a DIRECTORY under caos-tools/ (caos
# SPEC, "Tools"), and caos — like nix — only ever sees git-tracked files, so
# the generic `build/` above would make this tool silently invisible rather
# than broken. Re-including the directory is what lets git descend into it;
# a `!caos-tools/build/**` alone cannot, an excluded parent is never walked.
!caos-tools/build/
replay-viewer/dist/
__pycache__/
*.pyc
*.dylib
*.dylib.abi
*.log
.DS_Store

# Project specific ignores.
client/screenshots/
players/modulabot/modulabot
players/modulabot/test/parity

# nanobanana art generation scratch (not shipped). Anchored to the repo root so
# it catches only /art/gen — the League Replayer's shipped dungeon-wall textures
# under client/art/walls/ ARE part of the build (staticRead into the server).
/art/
# nanobanana rig-art generation scratch (candidate images, not shipped). The
# SHIPPED rig segments live under data/rig_real/ (readImage at runtime).
/nanobanana-output/
# data/rig_real holds the SHIPPED rig segments under red/ and blue/ (+ anchors.json,
# the generator interface). Loose PNGs at its root are art-exploration scratch — the
# subdir segments are still tracked because this only matches the top level.
/data/rig_real/*.png

# Local coworld package build output. CI builds the real package to build/ from
# the tracked coworld_manifest_paintbot.json; dist/ is a local convenience artifact.
/dist/
trench-demo.bitreplay
pool-preview/

# Arena Component Model build outputs (generated bindings remain tracked).
/arena/.nimcache/
/arena/*.wasm
data/replays/
barrier-demo.bitreplay
perks-2v2-demo.bitreplay

# The mount point .caos-expr splices caos's std/ into. Never committed — the
# loader REFUSES to overwrite an entry that is already there.
/caos-std/
